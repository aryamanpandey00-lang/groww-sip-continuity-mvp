# Phase 5 server-only assistant configuration.
# Never expose an API key through NEXT_PUBLIC_* variables or client code.
# Leave the key blank for tests, fixture evaluation and the dashboard.
ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
MAX_OUTPUT_TOKENS=700

# Stable server-only HMAC key for fictional action sessions. Use at least 32 random bytes.
# Do not rotate per request or expose through a NEXT_PUBLIC_* variable.
ACTION_SESSION_SIGNING_SECRET=
