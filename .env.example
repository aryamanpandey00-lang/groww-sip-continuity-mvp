# Phase 5 server-only GroqCloud assistant configuration.
# Never expose an API key through NEXT_PUBLIC_* variables or client code.
# Leave the key blank for tests, fixture evaluation and the dashboard.
ASSISTANT_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_RESPONSE_FORMAT=json_object
MAX_OUTPUT_TOKENS=700
# Server-only connection URL for the restricted runtime database role.
# Never use the database owner or migration credentials here.
DATABASE_RUNTIME_URL=

# Stable server-only HMAC key for fictional action sessions. Use at least 32 random bytes.
# Do not rotate per request or expose through a NEXT_PUBLIC_* variable.
ACTION_SESSION_SIGNING_SECRET=

# Set only after shared PostgreSQL adapters have been configured and independently verified.
SHARED_RUNTIME_VERIFIED=false
